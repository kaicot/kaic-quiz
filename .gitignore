.agents/

# Secrets, credentials, signing material, and local environment
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
*.jks
*.keystore
*.cer
*.crt
*.csr
*.pub
*.sig
credentials*.json
