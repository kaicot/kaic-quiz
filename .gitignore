build/
dist/
wheelhouse/
*.whl
*.exe
*.msi
*.msix
*.appx
*.spec.bak

# IDE, editor, and operating-system files
.vscode/
.idea/
*.code-workspace
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

