# Runtime logs and temporary files
logs/
*.log
*.tmp
*.temp
*.bak
~$*

# Student data and generated office documents: never committed.
# Tests build their own synthetic files in a temporary folder.
*.pdf
*.xlsx
*.xlsm
*.csv
*.tsv

# Portable application state (always user/runtime data)
/Data/
/update.json
/config.json

# Local release evidence and handoff material
artifacts/
*.local.md

# Single-instance lock beside the program
/.quiz-reporter.lock
